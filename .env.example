# ── LLM Provider ─────────────────────────────────────────────────────────
# Set LLM_PROVIDER to switch the chat model backend.
# Supported: azure_openai (default), openai, anthropic, google, ollama
LLM_PROVIDER=azure_openai

# ── Azure OpenAI (required when LLM_PROVIDER=azure_openai) ─────────────
AZURE_OPENAI_API_KEY=azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=deployment-name
AZURE_OPENAI_API_VERSION=model-api-version

# ── Anthropic (required when LLM_PROVIDER=anthropic) ────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Google Gemini (required when LLM_PROVIDER=google) ───────────────────
# GOOGLE_API_KEY=AI...
# GOOGLE_MODEL=gemini-2.0-flash

# ── Ollama / local (required when LLM_PROVIDER=ollama) ──────────────────
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# External APIs
EXCHANGERATE_API_KEY=exchangerate-api-key

# Duffel (flight search) — https://duffel.com/docs
DUFFEL_ACCESS_TOKEN=duffel_test_your-token-here

# Google Maps Platform — https://console.cloud.google.com/apis/credentials
# Enable: Places API (New), Routes API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=google-maps-api-key

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=langsmith-project-name
LANGCHAIN_API_KEY=langsmith-api-key

# Tavily
TAVILY_API_KEY=tavily-api-key

# App
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=120

# Anonymous browser session ownership
# Use a stable random value with at least 32 bytes. Deployed environments fail
# closed without it. This example is for local development only.
SESSION_SIGNING_KEY=local-development-only-signing-key-change-me-1234567890
SESSION_COOKIE_MAX_AGE_SECONDS=2592000
SESSION_COOKIE_SECURE=false

# Request rate limiting
# Direct development defaults to memory; Compose and deployed environments use Redis.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60
# REDIS_URL=redis://redis:6379

# LangGraph checkpoints
# Direct development defaults to memory; Docker Compose overrides this with PostgreSQL.
# Production fails closed unless PostgreSQL is selected and configured.
CHECKPOINT_BACKEND=memory
# CHECKPOINT_DATABASE_URL=postgresql://wanderlisted:localdev@postgres:5432/wanderlisted
CHECKPOINT_AUTO_SETUP=true

# Session registry (messages/artifacts remain in LangGraph checkpoints)
# Deployed environments require PostgreSQL. Direct development defaults to memory.
SESSION_REGISTRY_BACKEND=memory
# SESSION_REGISTRY_DATABASE_URL=postgresql://wanderlisted:localdev@postgres:5432/wanderlisted
SESSION_REGISTRY_AUTO_SETUP=true
SESSION_RETENTION_DAYS=365

# Bilingual Atlas Sunrise workspace rollout
CHAT_UI_V2_ENABLED=false
CONSULTATION_URL_EN=
CONSULTATION_URL_PL=

# Optional Clerk account boundary. Keep disabled until the Clerk application,
# email-code and Google connections, allowed origins, and secrets are configured.
CLERK_ENABLED=false
CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
CLERK_ISSUER=https://example.clerk.accounts.dev
CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_OWNER_HASH_KEY=local-development-only-owner-hash-key-change-me-1234567890
CLERK_JWKS_CACHE_SECONDS=300
CLERK_CLOCK_SKEW_SECONDS=5
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_base64-value-from-clerk
CLERK_WEBHOOK_TOLERANCE_SECONDS=300
